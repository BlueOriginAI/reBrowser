diff --git a/chrome/browser/browseros/account/BUILD.gn b/chrome/browser/browseros/account/BUILD.gn
new file mode 100644
--- /dev/null
+++ b/chrome/browser/browseros/account/BUILD.gn
@@ -0,0 +1,77 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license.
+import("//testing/test.gni")
+
+source_set("oauth") {
+  sources = [
+    "remocode_oauth.cc",
+    "remocode_oauth.h",
+  ]
+  public_deps = [ "//url" ]
+  deps = [
+    "//base",
+    "//crypto",
+    "//net",
+  ]
+}
+
+source_set("account") {
+  sources = [
+    "remocode_account_service.cc",
+    "remocode_account_service.h",
+    "remocode_account_service_factory.cc",
+    "remocode_account_service_factory.h",
+    "remocode_callback_server.cc",
+    "remocode_callback_server.h",
+  ]
+  public_deps = [
+    ":oauth",
+    "//base",
+    "//chrome/browser/profiles:profile",
+    "//components/keyed_service/content",
+    "//components/keyed_service/core",
+    "//net",
+    "//components/os_crypt/async/common",
+    "//services/network/public/cpp",
+  ]
+  deps = [
+    "//chrome/browser:browser_process",
+    "//chrome/browser/profiles:profile_manager",
+    "//chrome/browser/profiles:profile_util",
+    "//components/os_crypt/async/browser",
+    "//components/prefs",
+    "//components/pref_registry",
+    "//content/public/browser",
+    "//services/network/public/mojom",
+  ]
+}
+
+# Small executable for the PKCE and exact callback security contract.
+test("remocode_oauth_unittests") {
+  sources = [ "remocode_oauth_unittest.cc" ]
+  deps = [
+    ":oauth",
+    "//base",
+    "//base/test:run_all_unittests",
+    "//net",
+    "//testing/gtest",
+  ]
+}
+
+# Included by chrome/test:unit_tests for profile/crypto/network lifecycle tests.
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "remocode_account_service_unittest.cc" ]
+  deps = [
+    ":account",
+    "//base",
+    "//base/test:test_support",
+    "//chrome/test:test_support",
+    "//components/os_crypt/async/browser:test_support",
+    "//components/prefs",
+    "//content/test:test_support",
+    "//net",
+    "//services/network:test_support",
+    "//testing/gtest",
+  ]
+}
